CREDENTIAL_SERVICE_APP_NAME=credential-service
CREDENTIAL_SERVICE_APP_PORT=8080
CREDENTIAL_SERVICE_APP_ENV=development

CREDENTIAL_SERVICE_DB_HOST=
CREDENTIAL_SERVICE_DB_PORT=5432
CREDENTIAL_SERVICE_DB_USER=postgres
CREDENTIAL_SERVICE_DB_PASSWORD=postgres
CREDENTIAL_SERVICE_DB_NAME=credential_service
CREDENTIAL_SERVICE_DB_SSL_MODE=disable

CREDENTIAL_SERVICE_DB_MAX_OPEN_CONNS=10
CREDENTIAL_SERVICE_DB_MAX_IDLE_CONNS=5
CREDENTIAL_SERVICE_DB_CONN_MAX_LIFETIME=30m

CREDENTIAL_SERVICE_DIGIO_BASE_URL=https://ext.digio.in:444
CREDENTIAL_SERVICE_DIGIO_TOKEN=
CREDENTIAL_SERVICE_DIGIO_TIMEOUT=30s

CREDENTIAL_SERVICE_CREDENTIAL_DEFAULT_VALIDITY=8760h
# Git-tracked YAML credential-type definitions (loaded once at process start).
CREDENTIAL_SERVICE_CREDENTIAL_TYPES_DIR=configs/credential-types

# ONDC signature auth for /verify-identity and /credential. Callers sign the exact raw
# request body with their Ed25519 private key; this service verifies it. Env keys are
# nested under AUTH_ (CREDENTIAL_SERVICE_AUTH_*).
CREDENTIAL_SERVICE_AUTH_ENABLED=false

# --- Key source: pick ONE of the two blocks below. ---

# 1. Registry lookup (production). The caller's signing_public_key is fetched from the
#    ONDC Registry per request and matched on the unique_key_id in its Authorization
#    header, so any registered subscriber can be authenticated. A lookup failure is an
#    authentication failure; there is no fallback to the static key below.
CREDENTIAL_SERVICE_AUTH_LOOKUP_URL=
# How long a resolved signing key is reused before re-querying the registry.
CREDENTIAL_SERVICE_AUTH_LOOKUP_CACHE_TTL=5m
# Bounds a single outbound /lookup call.
CREDENTIAL_SERVICE_AUTH_LOOKUP_TIMEOUT=10s
# This service's own credentials. Required when LOOKUP_URL is set: the /lookup call must
# itself be signed. Private key is base64, either a 32-byte seed or a 64-byte key.
CREDENTIAL_SERVICE_AUTH_SIGNING_PRIVATE=
CREDENTIAL_SERVICE_AUTH_SIGNING_PUBLIC=
CREDENTIAL_SERVICE_AUTH_SUBSCRIBER_ID=
CREDENTIAL_SERVICE_AUTH_UNIQUE_KEY_ID=

# POST /generate-header signs any payload with the key above and is UNAUTHENTICATED.
# Unset, it follows CREDENTIAL_SERVICE_APP_ENV: on in development, off elsewhere.
# Set it explicitly to force. Never enable it on a reachable deployment.
CREDENTIAL_SERVICE_AUTH_ENABLE_HEADER_GENERATOR=

# 2. Static key (local testing only, when no registry is reachable). Trusts exactly one
#    signer. Leave LOOKUP_URL empty to use this path.
CREDENTIAL_SERVICE_AUTH_REGISTRY_SIGNING_PUBLIC_KEY=
# Optional: pin the Authorization keyId to that one known identity.
CREDENTIAL_SERVICE_AUTH_REGISTRY_SUBSCRIBER_ID=
CREDENTIAL_SERVICE_AUTH_REGISTRY_UNIQUE_KEY_ID=
