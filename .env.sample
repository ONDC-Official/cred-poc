CREDENTIAL_SERVICE_APP_NAME=credential-service
CREDENTIAL_SERVICE_APP_PORT=8080
CREDENTIAL_SERVICE_APP_ENV=development

CREDENTIAL_SERVICE_DB_HOST=
CREDENTIAL_SERVICE_DB_PORT=5432
CREDENTIAL_SERVICE_DB_USER=postgres
CREDENTIAL_SERVICE_DB_PASSWORD=postgres
CREDENTIAL_SERVICE_DB_NAME=credential_service
CREDENTIAL_SERVICE_DB_SSL_MODE=disable

CREDENTIAL_SERVICE_DB_MAX_OPEN_CONNS=10
CREDENTIAL_SERVICE_DB_MAX_IDLE_CONNS=5
CREDENTIAL_SERVICE_DB_CONN_MAX_LIFETIME=30m

CREDENTIAL_SERVICE_DIGIO_BASE_URL=https://ext.digio.in:444
CREDENTIAL_SERVICE_DIGIO_TOKEN=
CREDENTIAL_SERVICE_DIGIO_TIMEOUT=30s

CREDENTIAL_SERVICE_CREDENTIAL_DEFAULT_VALIDITY=8760h
# Git-tracked YAML credential-type definitions (loaded once at process start).
CREDENTIAL_SERVICE_CREDENTIAL_TYPES_DIR=configs/credential-types

# Service-to-service auth: only the registry service may call /verify-identity and /credential.
# Registry signs requests with its Ed25519 private key; this service verifies with the public key below.
# Env keys are nested under AUTH_ (CREDENTIAL_SERVICE_AUTH_*).
CREDENTIAL_SERVICE_AUTH_ENABLED=false
CREDENTIAL_SERVICE_AUTH_REGISTRY_SIGNING_PUBLIC_KEY=
# Optional: require Authorization keyId to match the registry identity
CREDENTIAL_SERVICE_AUTH_REGISTRY_SUBSCRIBER_ID=
CREDENTIAL_SERVICE_AUTH_REGISTRY_UNIQUE_KEY_ID=
# Optional: this service's own keypair for future signed calls back to registry
CREDENTIAL_SERVICE_AUTH_SIGNING_PRIVATE=
CREDENTIAL_SERVICE_AUTH_SIGNING_PUBLIC=
CREDENTIAL_SERVICE_AUTH_SUBSCRIBER_ID=
CREDENTIAL_SERVICE_AUTH_UNIQUE_KEY_ID=
