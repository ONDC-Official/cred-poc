# ==============================================================================
# Environment Configuration for Central OTel Collector
# ==============================================================================

# Name of the shared Docker network on the server
DOCKER_NETWORK_NAME=cred_network

# Endpoint to Loki:
# Scenario 1: If Loki is running on the host machine directly (systemd / binary):
LOKI_ENDPOINT=http://host.docker.internal:3100

# Scenario 2: If Loki is running as a Docker container on the same network:
# LOKI_ENDPOINT=http://loki:3100
# (replace 'loki' with the actual container_name of your Loki container)
